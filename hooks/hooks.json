{
  "description": "team-memory hooks: inject .memory/ at session start, recall entries on each prompt and before edits, ask before #hold areas, remind to record memory before stopping.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pm-hook.sh\" session-start claude plugin", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pm-hook.sh\" prompt claude plugin", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pm-hook.sh\" pre-edit claude plugin", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/pm-hook.sh\" stop claude plugin", "timeout": 15 } ] }
    ]
  }
}
